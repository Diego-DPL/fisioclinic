---
import Layout from '../layouts/Layout.astro'

interface Props {
  title: string
  description: string
  path: string
}
const { title, description, path } = Astro.props
---

<Layout title={`${title} | FisioClinic Murcia`} description={description} canonical={`https://www.fisioclinicmurcia.com${path}`}>
  <section class="bg-green-principal py-14 md:py-20">
    <div class="container mx-auto px-4">
      <h1 class="font-display text-3xl md:text-5xl font-medium text-white">{title}</h1>
    </div>
  </section>
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-3xl legal-prose">
      <slot />
    </div>
  </section>
</Layout>

<style is:global>
  .legal-prose { color: #374151; line-height: 1.75; }
  .legal-prose h2 { font-family: var(--font-display, inherit); font-size: 1.4rem; font-weight: 600; color: #00594c; margin: 2.2rem 0 0.75rem; }
  .legal-prose h3 { font-size: 1.1rem; font-weight: 600; color: #111827; margin: 1.5rem 0 0.5rem; }
  .legal-prose p { margin: 0.75rem 0; }
  .legal-prose ul { list-style: disc; padding-left: 1.5rem; margin: 0.75rem 0; }
  .legal-prose li { margin: 0.35rem 0; }
  .legal-prose a { color: #00594c; text-decoration: underline; }
  .legal-prose table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 1rem 0; display: block; overflow-x: auto; }
  .legal-prose th, .legal-prose td { border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
  .legal-prose th { background: #f3f4f6; }
</style>
